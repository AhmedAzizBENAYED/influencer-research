# ── Required ──────────────────────────────────────────────────
GOOGLE_API_KEY=        # Gemini — https://aistudio.google.com/apikey
TAVILY_API_KEY=        # Web search — https://tavily.com
NOVADA_API_KEY=        # Google SERP scraping — https://www.novada.com
RAPIDAPI_KEY=          # LinkedIn / Twitter / Facebook endpoints — https://rapidapi.com

# ── Optional: email outreach (Gmail needs an App Password) ────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Generated emails are delivered here instead of to the influencer (defaults to EMAIL_USER)
OUTREACH_TEST_RECIPIENT=

# ── Optional overrides ────────────────────────────────────────
# MODEL_NAME=gemini-2.5-flash
# EMAIL_MODEL_NAME=gemini-2.0-flash
# OUTPUT_DIR=outputs
